{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: project folders and CapCut draft directories can live anywhere on disk",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    },
    "dialog:default",
    "sql:default",
    "sql:allow-execute"
  ]
}
